################################################################################
# OpenClaw 环境变量配置模板
#
# 复制此文件为: openclaw.env
# 填写实际的值后使用: source openclaw.env
#
# ⚠️  警告：不要将包含实际密钥的 env 文件提交到代码仓！
################################################################################

################################################################################
# NVIDIA API 配置
################################################################################

# NVIDIA Base URL（通常不需要修改）
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA API Key
# 获取地址: https://build.nvidia.com/
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE

# NVIDIA 模型 ID
NVIDIA_MODEL_ID=z-ai/glm4.7

################################################################################
# 飞书（Feishu）配置
################################################################################

# 飞书应用 ID
# 获取地址: https://open.feishu.cn/app
FEISHU_APP_ID=cli_YOUR_APP_ID_HERE

# 飞书应用密钥
FEISHU_APP_SECRET=YOUR_APP_SECRET_HERE

# 飞书启用状态
FEISHU_ENABLED=true

# 飞书私信策略
# open: 允许所有人私信
# whitelist: 仅允许白名单用户
FEISHU_DM_POLICY=open

# 飞书允许来源
# *: 所有用户
# user_xxx: 特定用户 ID
FEISHU_ALLOW_FROM=*

################################################################################
# Gateway 配置
################################################################################

# Gateway 端口
GATEWAY_PORT=19002

# Gateway 绑定地址
# 127.0.0.1: 仅本地访问
# 0.0.0.0: 允许远程访问（不安全）
GATEWAY_BIND=127.0.0.1

# Gateway 认证模式
# token: 令牌认证（推荐）
# basicauth: HTTP 基本认证
# none: 无认证（仅用于开发）
GATEWAY_AUTH_MODE=token

# Gateway 令牌
# 生成方式: openssl rand -hex 32
GATEWAY_TOKEN=CHANGE_THIS_TO_SECURE_TOKEN_32_BYTES_HEX

# 受信任的代理 IP（如果使用反向代理）
# 使用逗号分隔: 192.168.1.100,10.0.0.50
GATEWAY_TRUSTED_PROXIES=

################################################################################
# Agent 配置
################################################################################

# 默认模型
DEFAULT_MODEL=nvidia/z-ai/glm4.7

# 工作区目录
WORKSPACE_DIR=/home/z/.openclaw/workspace

# 压缩模式
# safeguard: 安全模式
# off: 关闭压缩
COMPACTION_MODE=safeguard

# 沙盒模式
# off: 关闭沙盒
# all: 所有请求使用沙盒
# on-demand: 按需使用沙盒
SANDBOX_MODE=off

################################################################################
# 日志配置
################################################################################

# 日志级别
# debug, info, warn, error
LOG_LEVEL=info

# 日志文件路径
LOG_FILE=$HOME/.openclaw/logs/gateway.log

################################################################################
# 数据库配置（可选）
################################################################################

# SQLite 路径（默认）
# DATABASE_URL=sqlite:$HOME/.openclaw/data/openclaw.db

# PostgreSQL（可选）
# DATABASE_URL=postgres://user:password@localhost:5432/openclaw

# MySQL/MariaDB（可选）
# DATABASE_URL=mysql://user:password@localhost:3306/openclaw

################################################################################
# 备份配置
################################################################################

# 备份目录
BACKUP_DIR=$HOME/openclaw-backups

# 自动备份间隔（秒）
# 86400 = 每天一次
AUTO_BACKUP_INTERVAL=86400

# 保留备份数量
BACKUP_RETENTION_COUNT=7

################################################################################
# 远程代码仓配置（可选）
################################################################################

# Git 远程仓库
GIT_REMOTE=https://github.com/liu183/My-novels-.git

# Git 分支
GIT_BRANCH=feature/reborn-1980-rich-village

# Git 提交时自动推送
GIT_AUTO_PUSH=true

################################################################################
# 性能配置
################################################################################

# 最大并发会话数
MAX_CONCURRENT_SESSIONS=10

# 会话超时（秒）
SESSION_TIMEOUT=3600

# 缓存 TTL（秒）
CACHE_TTL=300

################################################################################
# 功能开关
################################################################################

# ACP（跨组件通信）启用
ACP_ENABLED=false

# 原生命令启用
COMMANDS_NATIVE=auto

# 原生技能启用
COMMANDS_NATIVE_SKILLS=auto

# 自动重启
COMMANDS_RESTART=true

# 遥测数据发送
TELEMETRY=false

################################################################################
# 插件配置
################################################################################

# 允许的插件列表
PLUGINS_ALLOW=feishu

# Webhook URL（可选）
WEBHOOK_URL=

# Webhook 签名密钥（可选）
WEBHOOK_SECRET=

################################################################################
# 安全配置（高级）
################################################################################

# CORS 源
CORS_ORIGINS=http://127.0.0.1:19002

# 最大请求大小（MB）
MAX_REQUEST_SIZE=10

# 请求超时（秒）
REQUEST_TIMEOUT=300

################################################################################
# 开发配置（开发环境使用）
################################################################################

# 调试模式
DEBUG=false

# 热重载
HOT_RELOAD=false

# 源码映射
SOURCE_MAP=false

################################################################################
# 自定义配置
################################################################################

# 自定义环境变量
# CUSTOM_VAR=value

################################################################################
# 使用说明
################################################################################

# 1. 复制模板
#    cp openclaw.env.template openclaw.env
#
# 2. 编辑配置
#    nano openclaw.env
#
# 3. 加载环境变量
#    source openclaw.env
#
# 4. 启动服务
#    openclaw gateway start
#
# 5. 或在 systemd 服务中加载
#    EnvironmentFile=/path/to/openclaw.env

################################################################################
# 生成示例
################################################################################

# 生成 Gateway Token
# openssl rand -hex 32

# 生成飞书加密密钥（如需要）
# openssl rand -base64 32
